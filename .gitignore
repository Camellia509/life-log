# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.vinext/
/out/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
.dev.vars*

# vercel
.vercel

# typescript
next-env.d.ts
*.tsbuildinfo
/dist/
/.wrangler/
/backups/
# Checkout-local execution profile and tool state; never publish them.
/.sites-runtime/
/.agents/
/.codex/
/outputs/
/work/*
!/work/fixtures/
!/work/fixtures/empty-life-template.mjs
!/work/api-test.mjs
!/work/excel-test.mjs
!/work/migration-test.py
!/work/static-build-test.mjs
!/work/full-export-test.mjs
!/work/backup-retention-test.mjs
!/work/backup-workflow-test.mjs
!/work/prepare-qa.mjs
!/work/qa-reset.sql

# Keep the non-secret environment template in version control.
!.env.example
