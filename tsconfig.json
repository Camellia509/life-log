{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["DOM", "DOM.Iterable", "ESNext"],
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {"@/*": ["./*"]},
    "types": ["vite/client"]
  },
  "include": ["src", "components", "lib", "db/schema.ts", "vite.config.ts"],
  "exclude": ["node_modules", "dist", "worker", "work"]
}
