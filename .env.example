# Browser development points directly to the local Worker origin.
VITE_API_BASE_URL=http://localhost:8787
BASE_PATH=/life-log/

# GitHub Pages build settings:
# BASE_PATH=/life-log/
# VITE_API_BASE_URL is intentionally unset until the production Worker exists.

# Worker production setup placeholders. Configure actual values outside Git.
# Do not put actual passwords or setup codes in this file.
ALLOWED_ORIGINS=
MINT_OWNER_EMAIL=
MINT_SETUP_TOKEN=
