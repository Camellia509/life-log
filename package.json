{
  "name": "mint-creek-life-log",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "npm run test:api && npm run test:excel && npm run test:migration && npm run test:full-export && npm run test:backup",
    "worker:db:init": "node scripts/init-worker-local.mjs",
    "worker:dev": "node scripts/run-worker-local.mjs",
    "worker:typecheck": "tsc -p worker/tsconfig.json",
    "worker:dry-run": "node --import ./scripts/wrangler-env.mjs ./node_modules/wrangler/bin/wrangler.js deploy --dry-run --config worker/wrangler.jsonc --outdir ../work/worker-dry-run",
    "db:generate": "drizzle-kit generate",
    "test:api": "node work/api-test.mjs",
    "test:excel": "node work/excel-test.mjs",
    "test:migration": "node scripts/run-migration-tests.mjs",
    "test:full-export": "node work/full-export-test.mjs",
    "test:backup": "node work/backup-retention-test.mjs && node work/backup-workflow-test.mjs",
    "backup:rehearse": "node scripts/backup/rehearse-local.mjs",
    "test:static": "node work/static-build-test.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@hookform/resolvers": "^5.7.1",
    "@shadcn/react": "^0.3.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "drizzle-orm": "0.45.2",
    "embla-carousel-react": "^8.6.0",
    "exceljs": "^4.4.0",
    "input-otp": "^1.4.2",
    "lucide-react": "^1.31.0",
    "radix-ui": "^1.6.7",
    "react": "19.2.6",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.6",
    "react-hook-form": "^7.85.0",
    "react-resizable-panels": "^4.12.2",
    "recharts": "^3.8.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "3.6.0",
    "vaul": "^1.1.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "4.20260515.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "tailwindcss": "4.2.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "vite": "8.0.13",
    "wrangler": "4.92.0",
    "@eslint/js": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.1.1",
    "typescript-eslint": "^8.59.3",
    "globals": "^14.0.0"
  },
  "type": "module",
  "overrides": {
    "miniflare": {
      "sharp": "0.35.4"
    }
  }
}
